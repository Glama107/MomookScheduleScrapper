# Copy to .env and fill in. Never commit the real file.

MOMOOK_BASE_URL=https://my.momook.com
MOMOOK_USERNAME=
MOMOOK_PASSWORD=

# Base32 secret behind the 2FA QR code (spaces are ignored). Empty if 2FA is off.
MOMOOK_TOTP_SECRET=

# Secret path segment of the feed URL. Generate with: openssl rand -hex 24
MOMOOK_FEED_TOKEN=

MOMOOK_TIMEZONE=Europe/Paris
MOMOOK_CALENDAR_NAME=Momook

# Feed window and refresh behaviour
MOMOOK_DAYS_PAST=30
MOMOOK_DAYS_FUTURE=180
MOMOOK_CACHE_TTL=300

# Set to false if the feed comes out empty (keeps group events you are not
# individually attached to)
MOMOOK_ONLY_MY_EVENTS=true

# Set to true to omit cancelled sessions instead of striking them through
MOMOOK_HIDE_CANCELLED=false
