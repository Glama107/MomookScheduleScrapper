# Copy to .env and fill in. Never commit the real file.

MOMOOK_BASE_URL=https://my.momook.com

# --- The first account ------------------------------------------------------
MOMOOK_USERNAME=
MOMOOK_PASSWORD=

# Base32 secret behind the 2FA QR code (spaces are ignored). Empty if 2FA is off.
MOMOOK_TOTP_SECRET=

# Secret path segment of the feed URL. Generate with: openssl rand -hex 24
MOMOOK_FEED_TOKEN=

# --- More people ------------------------------------------------------------
# Add a numbered block per person. Each needs its own feed token: it is the
# whole of what keeps one subscriber from reading another's schedule.
# Anything left out of a block falls back to the global value below.
#
# MOMOOK_ACCOUNT_1_LABEL=Marie
# MOMOOK_ACCOUNT_1_USERNAME=marie@example.com
# MOMOOK_ACCOUNT_1_PASSWORD=
# MOMOOK_ACCOUNT_1_TOTP_SECRET=
# MOMOOK_ACCOUNT_1_FEED_TOKEN=
#
# Optional per-account overrides:
# MOMOOK_ACCOUNT_1_CALENDAR_NAME=Momook — Marie
# MOMOOK_ACCOUNT_1_TIMEZONE=Europe/Paris
# MOMOOK_ACCOUNT_1_ONLY_MY_EVENTS=true
# MOMOOK_ACCOUNT_1_HIDE_CANCELLED=false
#
# `momook-ics accounts --urls` prints the roster and each feed URL to hand out.

MOMOOK_TIMEZONE=Europe/Paris
MOMOOK_CALENDAR_NAME=Momook

# Feed window and refresh behaviour
MOMOOK_DAYS_PAST=7
MOMOOK_DAYS_FUTURE=90
MOMOOK_CACHE_TTL=1800
MOMOOK_CHUNK_DAYS=21
MOMOOK_HTTP_TIMEOUT=120

# Accounts refresh one at a time; seconds of quiet between two of them.
MOMOOK_REFRESH_GAP=15

# Set to false if the feed comes out empty (keeps group events you are not
# individually attached to)
MOMOOK_ONLY_MY_EVENTS=true

# Set to true to omit cancelled sessions instead of striking them through
MOMOOK_HIDE_CANCELLED=false
